# Upstash Redis (free plan). Added automatically if you create it from Vercel > Storage.
KV_REST_API_URL=https://xxxx.upstash.io
KV_REST_API_TOKEN=...

# Your private access key. The site asks for it once per device.
APP_KEY=choose-a-long-random-passphrase

# ---- AI: choose ONE option ----
# Option A: a provider with a free tier (any OpenAI-compatible API)
#   Google Gemini (key from aistudio.google.com):
AI_API_KEY=...
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-2.5-flash
#   Groq (key from console.groq.com):
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_MODEL=llama-3.3-70b-versatile
#   Check each provider's current model names and free limits.

# Option B: Anthropic (paid API; leave AI_API_KEY unset)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5
